# AUDIT v0.8.3 (medium #11, #7): ignore build artifacts and test temp files

# Virtual environment
venv/
env/
ENV/

# Python files
__pycache__/
*.py[cod]
*$py.class
*.so

# Overly detailed documentation; all the essentials are in README.md
AGENTS.md
AUDIT.md
PYTE82_AUDIT.md
CHANGELOG.md
CHANGELOG_HISTORY.md
CHANGELOG_HISTORY_PREV1.md
DOCUMENTATION.md
ROADMAP.md

# Secrets and configuration
.env
*.key
config_secret.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# Smoke-test temp files (v1.1.2 final N12: wildcard — all _tmp_testdata*)
_tmp_testdata*/

# Test runner artifacts (JUnit XML + --failed-only cache)
test-results/

# Application logs
*.log

# Map data: contains real network topology/hosts — do not publish
server_map1.json
server_map2.json
server_map1.drawio
*.sshmap.json

# SSH profiles (in case of running from the project root)
.sshmap_profiles.json

# Build artifacts / tooling
build/
dist/
*.egg-info/
.pytest_cache/
