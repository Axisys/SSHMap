# AUDIT v0.8.3 (средняя #11, #7): игнор артефактов сборки и тестовых временных файлов

# Виртуальное окружение
venv/
env/
ENV/

# Файлы Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Избыточная в подробностях документация, все основное в README.md
CHANGELOG.md
CHANGELOG_HISTORY.md
DOCUMENTATION.md
ROADMAP.md
TERMINAL.md
FEATURES_REVIEW.md

# Секреты и конфигурации
.env
*.key
config_secret.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# Временные файлы smoke-тестов
_tmp_testdata/
_tmp_testdata_v097/

# Логи приложения
*.log

# Данные карт: содержат топологию/хосты реальной сети — не публиковать
server_map1.json
server_map1.drawio
*.sshmap.json

# Профили SSH (на случай запуска из корня проекта)
.sshmap_profiles.json

# Артефакты сборки / инструменты
build/
dist/
*.egg-info/
.pytest_cache/
