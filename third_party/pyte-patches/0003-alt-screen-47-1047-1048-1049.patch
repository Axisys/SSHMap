@@ -438,6 +458,45 @@
         # Hide the cursor.
         if mo.DECTCEM in mode_list:
             self.cursor.hidden = True
+
+    # ── sshmap fork (patch 0003): alternate screen buffer ───────────────────────
+    # Semantics — upstream PR #212 (author dwgx, closed without merge on
+    # 2026-08-14; pyte is LGPL-3.0 — attribution to the PR author is mandatory),
+    # differentially verified against tmux 3.6b and GNU screen: one in_alt flag
+    # (ESC[?47l exits a screen entered via 1049h); entry — save the main buffer,
+    # working = empty new (cursor is NOT homed — the TUI sends CUP itself; re-entry
+    # is idempotent); exit — restore the saved buffer clipped to current width,
+    # discard the alt buffer (contents do not survive a round-trip); cursor is
+    # saved/restored only for 1048/1049 (xterm: 1049 = 1047+1048) in a separate
+    # _alt_cursor field, NOT the savepoints stack.
+
+    def _enter_alt(self, save_cursor: bool) -> None:
+        if self.in_alt:
+            return  # re-entry is idempotent (main buffer is not lost)
+        self._saved_buffer = self.buffer
+        self.buffer = defaultdict(lambda: StaticDefaultDict[int, Char](self.default_char))
+        self.dirty.update(range(self.lines))
+        if save_cursor:  # only 1048/1049 (xterm: 1049 = 1047+1048)
+            self._alt_cursor = copy.copy(self.cursor)
+        self.in_alt = True  # cursor is NOT homed — the TUI sends CUP itself
+
+    def _exit_alt(self, restore_cursor: bool) -> None:
+        if not self.in_alt:
+            return
+        saved = self._saved_buffer
+        for line in saved.values():  # clip to current width (resize safety;
+            for x in [x for x in line if x >= self.columns]:  # same bounds as Screen.resize)
+                line.pop(x, None)
+        self.buffer = saved  # alt buffer discarded: contents do not survive a round-trip
+                             # (tmux/screen behave the same)
+        self.in_alt = False
+        self._saved_buffer = None
+        self.dirty.update(range(self.lines))
+        if restore_cursor and self._alt_cursor is not None:
+            self.cursor = self._alt_cursor
+            self._alt_cursor = None
+            self.ensure_hbounds()  # clamp after a possible resize while in alt
+            self.ensure_vbounds()
 
     def define_charset(self, code: str, mode: str) -> None:
         """Define ``G0`` or ``G1`` charset.
